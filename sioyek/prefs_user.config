# ═══════════════════════════════════════════════════════════════════════════
#  prefs_user.config  —  User preferences for sioyek
#
#  Reference: /etc/sioyek/prefs.config
#  Docs:      https://sioyek-documentation.readthedocs.io/
#
#  Design notes:
#    • Sioyek saves the current page/scroll position to its internal SQLite
#      database (local.db / shared.db) only on clean quit, not continuously.
#      On next launch, each document resumes from where you left off.
#      Known limitation: https://github.com/ahrm/sioyek/issues/1431
#    • This file only overrides defaults; unset options keep their built-in
#      values from prefs.config.
# ═══════════════════════════════════════════════════════════════════════════

# ── Shared database (optional: sync bookmarks/marks/highlights across machines) ──
#   When set, all persistent data (bookmarks, highlights, last-read positions, etc.)
#   is stored here instead of the default ~/.local/share/sioyek/shared.db.
#   Useful for syncing via Dropbox, Syncthing, etc.
#shared_database_path  /home/clovolc/.dotfiles/sioyek/shared.db

# ── Commands to run at startup ──────────────────────────────────────────────
#   toggle_visual_scroll  — continuous (per-pixel) scrolling instead of page-at-a-time
#   toggle_dark_mode      — start in dark mode
#startup_commands  toggle_visual_scroll

# ── Touchpad / scroll sensitivity (higher = faster) ─────────────────────────
touchpad_sensitivity  1.0

# ── Search ──────────────────────────────────────────────────────────────────
super_fast_search     1

# ── Appearance ──────────────────────────────────────────────────────────────
default_dark_mode     1
