#!/bin/bash
# Run commands inside a guest via the QEMU guest agent (works with no guest network).
# Usage: ./vir-exec COMMAND VM_NAME [ARGS]
#   setup  VM                    add the org.qemu.guest_agent.0 channel to the VM
#   ping   VM                    check that the guest agent is responding
#   info   VM                    guest OS, hostname and agent version
#   run    VM CMD...             run CMD via cmd.exe /c, print stdout/stderr
#   ps     VM SCRIPT             run SCRIPT via powershell (quoting-safe)
#   sh     VM CMD...             run CMD via /bin/sh -c (linux guests)
#   push   VM LOCAL REMOTE       copy a host file into the guest
#   pull   VM REMOTE [LOCAL]     copy a guest file out to the host
#   raw    VM JSON               send a raw guest agent command
#
# virt-manager does not add the agent channel itself, so `setup` is needed once per
# VM (plus qemu-ga in the guest: virtio-win guest-agent MSI on Windows). Commands
# run as SYSTEM on Windows / root on Linux. The guest exit code becomes ours.

set -euo pipefail

# silences virsh's "setlocale: No such file or directory" on minimal/WSL hosts
export LC_ALL=C

usage() {
    echo "usage: $0 {setup|ping|info|run|ps|sh|push|pull|raw} VM_NAME [ARGS]" >&2
    exit 1
}

CMD="${1:-}"
[ -n "$CMD" ] || usage
VM="${2:-}"
[ -n "$VM" ] || usage
shift 2

VIRSH="virsh -q -c qemu:///system"

# base64 chars per file-transfer round trip -- the JSON ends up in virsh's argv,
# so this has to stay well under ARG_MAX
CHUNK=65536

# a handle left open locks the file inside the guest, so always close it, even on
# a mid-transfer failure; deliberately does not go through agent(), which exits
close_handle() {
    [ -n "${H:-}" ] || return 0
    $VIRSH qemu-agent-command "$VM" \
        "$(jq -nc --argjson h "$H" '{execute:"guest-file-close",arguments:{handle:$h}}')" \
        >/dev/null 2>&1 || true
    H=
}

# agent JSON -> stdout; dies on an agent-level error rather than feeding jq garbage
agent() {
    local reply
    reply=$($VIRSH qemu-agent-command "$VM" "$1" 2>&1) || true
    case "$reply" in
        *'"error"'*|error:*) echo "$reply" >&2; exit 1 ;;
    esac
    echo "$reply"
}

# powershell serialises its error stream as CLIXML whenever stderr is redirected,
# which it always is here; unwrap it back into the plain text a terminal expects
declixml() {
    python3 -c '
import re, sys, xml.etree.ElementTree as ET
d = sys.stdin.read()
if not d.startswith("#< CLIXML"):
    sys.stdout.write(d); sys.exit()
try:
    root = ET.fromstring(d.split("\n", 1)[1])
except ET.ParseError:
    sys.stdout.write(d); sys.exit()
t = "".join(e.text or "" for e in root.iter() if e.tag.rpartition("}")[2] == "S")
sys.stdout.write(re.sub(r"_x([0-9A-Fa-f]{4})_", lambda m: chr(int(m.group(1), 16)), t))
'
}

# gexec PATH ARGS_JSON -- wait for completion, print out/err, return guest exit code
gexec() {
    local pid st out err ec
    pid=$(agent "$(jq -nc --arg p "$1" --argjson a "$2" \
        '{execute:"guest-exec",arguments:{path:$p,arg:$a,"capture-output":true}}')" \
        | jq -r '.return.pid')

    while :; do
        st=$(agent "$(jq -nc --argjson pid "$pid" \
            '{execute:"guest-exec-status",arguments:{pid:$pid}}')")
        [ "$(jq -r '.return.exited' <<<"$st")" = true ] && break
        sleep 0.2
    done

    # \r stripped so windows output pipes cleanly into unix tools
    out=$(jq -r '.return["out-data"] // empty' <<<"$st")
    err=$(jq -r '.return["err-data"] // empty' <<<"$st")
    if [ -n "$out" ]; then base64 -d <<<"$out" | tr -d '\r'; fi
    if [ -n "$err" ]; then base64 -d <<<"$err" | declixml | tr -d '\r' >&2; fi

    ec=$(jq -r '.return.exitcode // 0' <<<"$st")
    return "$ec"
}

case "$CMD" in
setup)
    if $VIRSH dumpxml "$VM" | grep -q org.qemu.guest_agent.0; then
        echo "$VM: channel already present"
        exit 0
    fi
    XML=$(mktemp) && trap 'rm -f "$XML"' EXIT
    cat >"$XML" <<'EOF'
<channel type='unix'>
  <source mode='bind'/>
  <target type='virtio' name='org.qemu.guest_agent.0'/>
</channel>
EOF
    $VIRSH attach-device "$VM" "$XML" --config
    # hotplug only works on a running VM; the --config copy covers the rest
    if [ "$($VIRSH domstate "$VM")" = running ]; then
        $VIRSH attach-device "$VM" "$XML" --live
    fi
    echo "$VM: channel added (install qemu-ga in the guest if not already there)"
    ;;
ping)
    agent '{"execute":"guest-ping"}' >/dev/null
    echo "$VM: agent up"
    ;;
info)
    # pretty-name lies on windows (reports the win10 sku), so build from version fields
    agent '{"execute":"guest-get-osinfo"}' \
        | jq -r '.return | "os: \(.version // .["pretty-name"] // .name) build \(.["kernel-release"] // "?") (\(.machine))"'
    agent '{"execute":"guest-get-host-name"}' | jq -r '"host-name: " + .return["host-name"]'
    agent '{"execute":"guest-info"}' | jq -r '"qemu-ga: " + .return.version'
    ;;
run)
    [ $# -gt 0 ] || { echo "usage: $0 run VM CMD..." >&2; exit 1; }
    gexec cmd.exe "$(jq -nc --arg c "$*" '["/c",$c]')"
    ;;
ps)
    SCRIPT="${1:?usage: $0 ps VM SCRIPT}"
    # UTF-16LE base64 sidesteps every quoting layer between here and the guest;
    # the preference kills "Preparing modules for first use" progress spam on stderr
    ENC=$(printf '$ProgressPreference="SilentlyContinue"\n%s' "$SCRIPT" \
        | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
    gexec powershell.exe "$(jq -nc --arg e "$ENC" \
        '["-NoProfile","-NonInteractive","-OutputFormat","Text","-EncodedCommand",$e]')"
    ;;
sh)
    [ $# -gt 0 ] || { echo "usage: $0 sh VM CMD..." >&2; exit 1; }
    gexec /bin/sh "$(jq -nc --arg c "$*" '["-c",$c]')"
    ;;
push)
    LOCAL="${1:?usage: $0 push VM LOCAL REMOTE}"
    REMOTE="${2:?usage: $0 push VM LOCAL REMOTE}"
    [ -r "$LOCAL" ] || { echo "$0: cannot read $LOCAL" >&2; exit 1; }

    H=$(agent "$(jq -nc --arg p "$REMOTE" \
        '{execute:"guest-file-open",arguments:{path:$p,mode:"wb"}}')" | jq -r '.return')
    # bash skips an EXIT trap for an untrapped fatal signal, so catch those too
    trap close_handle EXIT
    trap 'exit 130' INT TERM

    # read exactly CHUNK chars at a time on fd 3 -- a `... | while read` pipeline
    # would run in a subshell, where a mid-transfer failure could not close $H
    exec 3< <(base64 -w0 "$LOCAL")
    while IFS= read -r -N "$CHUNK" chunk <&3 || [ -n "$chunk" ]; do
        # chunk goes to jq on stdin, not argv: 1 MiB of base64 exceeds ARG_MAX
        agent "$(printf '%s' "$chunk" | jq -Rc --argjson h "$H" \
            '{execute:"guest-file-write",arguments:{handle:$h,"buf-b64":.}}')" >/dev/null
        chunk=
    done
    exec 3<&-

    close_handle
    echo "pushed $LOCAL ($(stat -c%s "$LOCAL") bytes) -> $VM:$REMOTE"
    ;;
pull)
    REMOTE="${1:?usage: $0 pull VM REMOTE [LOCAL]}"
    LOCAL="${2:-$(basename "${REMOTE//\\//}")}"

    H=$(agent "$(jq -nc --arg p "$REMOTE" \
        '{execute:"guest-file-open",arguments:{path:$p,mode:"rb"}}')" | jq -r '.return')
    # bash skips an EXIT trap for an untrapped fatal signal, so catch those too
    trap close_handle EXIT
    trap 'exit 130' INT TERM

    : >"$LOCAL"
    while :; do
        R=$(agent "$(jq -nc --argjson h "$H" --argjson n "$((CHUNK/2))" \
            '{execute:"guest-file-read",arguments:{handle:$h,count:$n}}')")
        jq -r '.return["buf-b64"] // empty' <<<"$R" | base64 -d >>"$LOCAL"
        [ "$(jq -r '.return.eof' <<<"$R")" = true ] && break
    done

    close_handle
    echo "pulled $VM:$REMOTE -> $LOCAL ($(stat -c%s "$LOCAL") bytes)"
    ;;
raw)
    agent "${1:?usage: $0 raw VM JSON}"
    ;;
*)
    usage
    ;;
esac
